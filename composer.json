{
    "name": "getgrav/grav-db-kit",
    "type": "library",
    "description": "Shared database, migration, job queue and event infrastructure for Trilby Media's Grav plugins (SQLite, MySQL, PostgreSQL)",
    "keywords": ["grav", "database", "pdo", "sqlite", "mysql", "postgresql", "migrations", "job-queue"],
    "homepage": "https://github.com/getgrav/grav-db-kit",
    "support": {
        "issues": "https://github.com/getgrav/grav-db-kit/issues",
        "source": "https://github.com/getgrav/grav-db-kit"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Trilby Media, LLC",
            "email": "hello@trilby.media"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-pdo_sqlite": "For the SQLite engine (the default)",
        "ext-pdo_mysql": "For the MySQL / MariaDB engine",
        "ext-pdo_pgsql": "For the PostgreSQL engine"
    },
    "autoload": {
        "psr-4": {
            "TrilbyMedia\\GravDbKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TrilbyMedia\\GravDbKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "packaging-check": "@php tools/packaging-check/run.php"
    },
    "config": {
        "sort-packages": true,
        "platform-check": false
    }
}
